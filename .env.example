# Smart Joint Monitor - Environment Variables Template
# Copy this file to .env and configure with your local or test credentials.
# NEVER commit or share .env containing real passwords or private broker credentials.

# Telemetry Source Mode: 'demo' or 'live'
VITE_TELEMETRY_MODE=demo

# Live MQTT Broker Configuration (WebSocket / TLS)
VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC=busbar/joint1/telemetry
VITE_MQTT_COMMAND_TOPIC=busbar/joint1/commands
VITE_MQTT_CLIENT_ID=smart-joint-pwa-client
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Live HTTP Polling Endpoint (ESP32 Local REST API fallback)
VITE_ESP32_HTTP_URL=http://192.168.1.50/api/telemetry
VITE_ESP32_POLL_INTERVAL_MS=1000

# App Version & Identity
VITE_APP_VERSION=1.0.0
VITE_APP_PROJECT_TITLE=Smart Joint Monitor
